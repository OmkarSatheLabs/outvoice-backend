# ==============================================================================
# OutVoice Backend Environment Variables Reference
# Copy this file to .env or set environment variables in your deployment environment.
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/outvoice
DB_USERNAME=postgres
DB_PASSWORD=local-db@123
DB_SCHEMA=outvoice

# Authentication & Security
JWT_SECRET=9f82c40b82f6e7c3b2a5d1e4c7b8a9f0e1d2c3b4a5f6e7d8c9b0a1f2e3d4c5b6
JWT_EXPIRY_MS=86400000
JWT_PASSWORD_RESET_EXPIRY_MS=3600000
ENCRYPTION_SECRET_KEY=0123456789abcdef0123456789abcdef

# Application & CORS
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://dev.outvoice.omkarsathe.com
FRONTEND_URL=http://localhost:4200

# ==============================================================================
# Object Storage Configuration
# ==============================================================================
# Provider selection: "local" (default for development) or "r2" (production)
STORAGE_PROVIDER=local

# --- Local Filesystem Storage (development) ---
STORAGE_LOCAL_BASE_DIR=./uploads
STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:8080/files

# --- Cloudflare R2 Storage (production) ---
# Required when STORAGE_PROVIDER=r2. The application will fail startup if missing.
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_BUCKET=outvoice-assets
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-s3-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-s3-secret-access-key
# Endpoint is derived automatically as https://${CLOUDFLARE_R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# Uncomment to override custom endpoint:
# CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_REGION=auto
# Public CDN / custom domain serving the assets bucket:
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://files.outvoice.omkarsathe.com
CLOUDFLARE_R2_CONNECT_TIMEOUT=10
CLOUDFLARE_R2_REQUEST_TIMEOUT=30

# Image upload constraints
STORAGE_MAX_FILE_SIZE=5242880

# Mail Configuration
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# SMS Configuration
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
